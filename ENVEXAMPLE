# =========================================================== #
# ENV CONFIG TEMPLATE                                         #
# Copy this file to PROJECT_ROOT/.env and fill in your values #
# PLEASE PLEAASE PLEASE do NOT ship this file to the public!  #
# Only you and the server must know about its existence or    #
# otherwise people will have access to your system and        #
# sensitive data.                                             #
# =========================================================== #

# WebSockets and REST API Configuration
ORIGINS=http://core:8000,http://localhost:8000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
APIURL=http://localhost:8000/ws
APITOKEN=your_secure_api_token_here
CLIENTHEADER=ClientHeader/1.0
JWTSECRET=random_64_char_string
VALKEYPASSWORD=your_secure_valkey_password_here
VALKEYURL=valkey://:${VALKEYPASSWORD}@valkey:6379
# OR JUST TYPE THE PASSWORK DIRECTLY THE URL

# Database Configuration (MongoDB)
DBENGINE=mongodb
DBURI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=YourAppName

# Security
SALT=your_random_salt_string_here
# THIS HELPS WITH RANDOMIZING SECURE HASHES
